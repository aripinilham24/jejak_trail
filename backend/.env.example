APP_ENV=development
APP_NAME=jejak-trail-api
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug
TRUST_PROXY=false

DATABASE_URL=postgres://jejak:jejak@localhost:5432/jejak?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=jt_refresh
COOKIE_SECURE=false
COOKIE_DOMAIN=

# base64 dari 32 byte (openssl rand -base64 32)
ENCRYPTION_KEY=GXJSdOf2qv0FU4MGkgu/OMqofV9QG5hycwqWdYdUHec=

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jejak-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Jejak Trail <no-reply@jejak.local>

PAYMENT_DRIVER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-dev
PAYMENT_WINDOW=24h
VERIFICATION_WINDOW=72h
PLATFORM_FEE_BPS=300
GATEWAY_FEE_FIXED=1000
GATEWAY_FEE_BPS=140
